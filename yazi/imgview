#!/usr/bin/env python3
"""Full-window image viewer for WezTerm, used by yazi's image opener.

Two ways of drawing, picked by asking the terminal at startup:
- kitty: the image is sent to the terminal once; zoom/pan only move the visible
  source rectangle, so a keypress sends a few bytes at full resolution.
  WezTerm needs `config.enable_kitty_graphics = true` for this.
- iterm: fallback. Each keypress crops the image in memory with Pillow and sends
  the frame as an iTerm2 inline image.
IMGVIEW_PROTOCOL=kitty|iterm forces one.

Keys: r zoom in, f zoom out, j left, k down, l up, ; right, 0 reset, q/Esc quit.
"""
import base64, fcntl, io, os, select, struct, subprocess, sys, termios, tty

from PIL import Image

ZOOM_STEP = 1.25
PAN_STEP = 0.15  # fraction of the visible area
RESOLUTION = 0.75  # iterm only: frame pixels per screen pixel; lower = lighter for WezTerm to decode
IMAGE_ID = 7031


def term_size():
    rows, cols, xpx, ypx = struct.unpack("HHHH", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8))
    return cols, rows, (xpx or cols * 10), (ypx or rows * 20)


def kitty_supported(fd):
    """Send a kitty graphics query followed by a DA1 query; every terminal answers DA1,
    and only terminals with kitty graphics answer the first one."""
    sys.stdout.write("\x1b_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA\x1b\\\x1b[c")
    sys.stdout.flush()
    resp = b""
    while b"\x1b[?" not in resp or not resp.endswith(b"c"):
        ready, _, _ = select.select([fd], [], [], 1.0)
        if not ready:
            break
        resp += os.read(fd, 1024)
    return b"_Gi=31;OK" in resp


def kitty_upload(image):
    buf = io.BytesIO()
    image.save(buf, "PNG", compress_level=1)
    data = base64.b64encode(buf.getvalue()).decode()
    chunks = [data[i:i + 4096] for i in range(0, len(data), 4096)]
    for n, chunk in enumerate(chunks):
        more = 1 if n < len(chunks) - 1 else 0
        head = f"a=t,f=100,i={IMAGE_ID},q=2,m={more}" if n == 0 else f"m={more}"
        sys.stdout.write(f"\x1b_G{head};{chunk}\x1b\\")
    sys.stdout.flush()


class View:
    def __init__(self, image, protocol):
        self.im = image
        self.protocol = protocol
        self.w, self.h = image.size
        self.rect = None  # cell rectangle of the last frame
        self.reset()

    def reset(self):
        self.zoom, self.cx, self.cy = 1.0, self.w / 2, self.h / 2

    def crop(self, tw, th):
        fit = min(tw / self.w, th / self.h)          # screen px per image px at zoom 1
        cw = min(self.w, tw / (fit * self.zoom))
        ch = min(self.h, th / (fit * self.zoom))
        self.cx = min(max(self.cx, cw / 2), self.w - cw / 2)
        self.cy = min(max(self.cy, ch / 2), self.h - ch / 2)
        return cw, ch, self.cx - cw / 2, self.cy - ch / 2, fit * self.zoom

    def render(self):
        cols, rows, tw, th = term_size()
        cw, ch, x, y, scale = self.crop(tw, th)
        ow, oh = max(1, int(cw * scale)), max(1, int(ch * scale))
        # Size in cells, centered; the last row is left for the status line.
        wc = max(1, min(cols, round(ow * cols / tw)))
        hc = max(1, min(rows - 1, round(oh * rows / th)))
        col, row = (cols - wc) // 2, (rows - 1 - hc) // 2

        if self.protocol == "kitty":
            # Re-place the already uploaded image (same placement id replaces it),
            # showing only the source rectangle x,y,w,h scaled to wc x hc cells.
            picture = (f"\x1b_Ga=p,i={IMAGE_ID},p=1,x={int(x)},y={int(y)},w={max(1, int(cw))},h={max(1, int(ch))},"
                       f"c={wc},r={hc},C=1,q=2\x1b\\")
        else:
            frame = self.im.resize((max(1, int(ow * RESOLUTION)), max(1, int(oh * RESOLUTION))),
                                   Image.BICUBIC, box=(x, y, x + cw, y + ch), reducing_gap=2.0)
            buf = io.BytesIO()
            frame.save(buf, "JPEG", quality=85)
            data = base64.b64encode(buf.getvalue()).decode()
            picture = f"\x1b]1337;File=inline=1;width={wc};height={hc};preserveAspectRatio=1:{data}\a"

        # Clear only when the frame's footprint changes; otherwise draw over the old one.
        rect = (col, row, wc, hc)
        clear = "\x1b[2J" if rect != self.rect else ""
        self.rect = rect
        # One write per frame, inside a synchronized update (?2026) so WezTerm shows it
        # only once complete: no blank screen while the new picture decodes.
        sys.stdout.write(f"\x1b[?2026h{clear}\x1b[{row + 1};{col + 1}H{picture}"
                         f"\x1b[{rows};1H\x1b[2K\x1b[2m {self.zoom:.2f}x  r/f zoom  jkl; move  0 reset  q quit"
                         f"  [{self.protocol}]\x1b[0m\x1b[?2026l")
        sys.stdout.flush()

    def key(self, k):
        _, _, tw, th = term_size()
        cw, ch, *_ = self.crop(tw, th)
        if k == "r":
            self.zoom *= ZOOM_STEP
        elif k == "f":
            self.zoom = max(1.0, self.zoom / ZOOM_STEP)
        elif k == "j":
            self.cx -= cw * PAN_STEP
        elif k == ";":
            self.cx += cw * PAN_STEP
        elif k == "k":
            self.cy += ch * PAN_STEP
        elif k == "l":
            self.cy -= ch * PAN_STEP
        elif k == "0":
            self.reset()
        else:
            return False
        return True


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: imgview <image>")
    src = sys.argv[1]
    if os.environ.get("TERM_PROGRAM") != "WezTerm":
        subprocess.run(["chafa", "--", src])
        input()
        return

    if src.lower().endswith(".svg"):  # Pillow can't read SVG
        png = subprocess.run(["resvg", "--width", "3000", "-c", src], capture_output=True, check=True).stdout
        image = Image.open(io.BytesIO(png))
    else:
        image = Image.open(src)
    image = image.convert("RGB")  # decode once

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    sys.stdout.write("\x1b[?1049h\x1b[?25l")
    protocol = None
    try:
        tty.setcbreak(fd)
        protocol = os.environ.get("IMGVIEW_PROTOCOL") or ("kitty" if kitty_supported(fd) else "iterm")
        if protocol == "kitty":
            kitty_upload(image)
        view = View(image, protocol)
        size = term_size()
        view.render()
        while True:
            ready, _, _ = select.select([fd], [], [], 0.3)
            if not ready:
                if term_size() != size:  # window resized
                    size = term_size()
                    view.render()
                continue
            keys = os.read(fd, 64).decode(errors="ignore")  # drain queued presses, redraw once
            if "q" in keys or "\x1b" in keys:
                break
            if any([view.key(k) for k in keys]):
                view.render()
    finally:
        if protocol == "kitty":
            sys.stdout.write(f"\x1b_Ga=d,d=I,i={IMAGE_ID},q=2\x1b\\")  # free the uploaded image
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[2J\x1b[?25h\x1b[?1049l")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
